# Database Configuration
# Defaults to local SQLite file for zero-setup execution.
# To use PostgreSQL, set: postgresql://username:password@localhost:5432/db_name
DATABASE_URL=sqlite:///ml_failure_investigator.db

# MLflow Configuration
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# LLM Configuration
# Required for running the LangGraph agent in later phases.
OPENAI_API_KEY=your-openai-api-key-here
